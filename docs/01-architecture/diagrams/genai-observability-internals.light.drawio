        <mxCell id="ob-k8s" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;processor.k8sattributes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[pod → namespace, labels]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Adds namespace and project label&lt;br&gt;to every span and metric.&lt;br&gt;Why: cost and errors per project.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1010" y="400" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ob-k8s__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ob-k8s">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ob-k8s__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#059669;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1259.6" y="392" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ob-transform" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;processor.transform&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[OTTL]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Drops gen_ai.input/output.messages&lt;br&gt;unless the project opted in.&lt;br&gt;Why: prompts are user data.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#fff1f2;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1360" y="400" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ob-transform__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ob-transform">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ob-transform__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#059669;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1609.6" y="392" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ob-batch" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;processor.batch&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[after memory_limiter]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Groups data before export.&lt;br&gt;Why: fewer, larger writes on a&lt;br&gt;small cluster.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1710" y="400" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ob-batch__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ob-batch">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ob-batch__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#059669;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1959.6" y="392" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ob-exp-otlp" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;exporter.otlp&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[→ Tempo :4317]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Sends the traces to Tempo.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1360" y="550" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ob-exp-otlp__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ob-exp-otlp">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ob-exp-otlp__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#059669;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1609.6" y="542" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ob-exp-prom" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;exporter.prometheus&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[→ prometheus.remote_write]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Turns OTel metrics into Prometheus&lt;br&gt;series, adds the scraped gateway ones&lt;br&gt;and pushes them to VictoriaMetrics.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1710" y="550" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ob-exp-prom__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ob-exp-prom">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ob-exp-prom__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#059669;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1959.6" y="542" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ob-prom" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;VictoriaMetrics&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[remote write receiver]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Token, latency and 429 series per&lt;br&gt;project and model.&lt;br&gt;Why: dashboards and alerts.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f5f3ff;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1710" y="860" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ob-prom__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ob-prom">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ob-prom__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#059669;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1959.6" y="852" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ob-alerts" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;Alert rules&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[Grafana alerting]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Budget at 80 %, 429s or refusals up.&lt;br&gt;Why: act before the budget is gone.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#fff1f2;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1710" y="1140" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ob-alerts__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ob-alerts">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ob-alerts__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#059669;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1959.6" y="1132" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n-ob-trace" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;One trace per request: the agent&amp;#39;s invoke_agent span is the parent; the gateway&amp;#39;s chat span and the tool proxy&amp;#39;s MCP span join it through the traceparent header.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="2160" y="260" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n-ob-attrs" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Attributes kept: gen_ai.operation.name, gen_ai.provider.name, gen_ai.request.model and response.model, gen_ai.usage.input_tokens and output_tokens, gen_ai.tool.name, plus namespace and project from k8sattributes.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="2160" y="450" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n-ob-content" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Message content (gen_ai.input.messages, output.messages) is off by default in the instrumentations, and the transform step drops it again unless the project opted in.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="2160" y="680" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="card-steps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#059669&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Request path · one agent call, three sources&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; The agent&amp;#39;s SDK sends its spans (invoke_agent, chat, execute_tool) to Alloy over OTLP. &lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; The gateway sends its spans over OTLP; Alloy scrapes its token and cost metrics on :15020. &lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; The ToolHive proxy sends mcp.* spans and metrics.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;4&lt;/span&gt;–&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;6&lt;/span&gt; Alloy adds namespace and project from the pod, drops message content unless opted in, then batches.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;7&lt;/span&gt; &lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;8&lt;/span&gt; Traces go to Tempo. &lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;9&lt;/span&gt; &lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;10&lt;/span&gt; Metrics become Prometheus series and reach VictoriaMetrics by remote write.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;11&lt;/span&gt; &lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;12&lt;/span&gt; Grafana reads traces with TraceQL and metrics with MetricsQL: tokens per project and model, latency, 429s, share of calls that fell back to the GPU server. Alert rules run on the same series.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="1400" width="1270" height="260" as="geometry" />
        </mxCell>
        <mxCell id="card-background" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#d97706&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Background · logs, already in place&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;A&lt;/span&gt; Alloy tails pod logs, including the gateway&amp;#39;s access logs, &lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;B&lt;/span&gt; pushes them to Loki, &lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;C&lt;/span&gt; where Grafana reads them next to the traces.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1350" y="1400" width="1270" height="260" as="geometry" />
        </mxCell>
        <mxCell id="card-objects" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#0284c7&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;FinOps with a free tier&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• With Gemini&amp;#39;s free tier, the money question becomes a quota question: tokens and requests per project against RPM, TPM and RPD.&lt;br&gt;• For the GPU server, the cost is the GPU&amp;#39;s time: latency and tokens per second per model.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="1700" width="1270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="card-legend" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Legend&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1350" y="1700" width="1270" height="360" as="geometry" />
        </mxCell>
        <mxCell id="legend-node-frontend" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ecfeff;strokeColor=#0891b2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1756" width="22" height="14" as="geometry" />
        </mxCell>
        <mxCell id="legend-node-frontend-text" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;client / frontend&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1402" y="1752" width="575" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend-node-backend" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1782" width="22" height="14" as="geometry" />
        </mxCell>
        <mxCell id="legend-node-backend-text" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;service / routing&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1402" y="1778" width="575" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend-node-database" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;" vertex="1" parent="1">
