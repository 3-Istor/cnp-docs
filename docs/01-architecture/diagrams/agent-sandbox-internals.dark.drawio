          <mxGeometry x="3049.6" y="322" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sb-c-core" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;Sandbox controller&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[agent-sandbox-controller]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Creates Pod + Service per Sandbox;&lt;br&gt;pauses, resumes, deletes on time.&lt;br&gt;Why: one stateful pod per sandbox.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#0b2d31;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="110" y="890" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sb-c-core__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="sb-c-core">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sb-c-core__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-2&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="359.6" y="882" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sb-c-ext" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;Extensions controllers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[template · warm pool · claim]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Fills the pool from the template,&lt;br&gt;binds each claim to a warm Sandbox.&lt;br&gt;Why: claims stay simple for agents.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#0b2d31;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="460" y="890" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sb-c-ext__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="sb-c-ext">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sb-c-ext__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-2&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="709.6" y="882" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sb-router" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;sandbox-router&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[sandbox-router-svc :8080]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Reverse proxy from the SDK to the&lt;br&gt;right sandbox pod.&lt;br&gt;Why: no port-forward under gVisor.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#0b2d31;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="550" y="1170" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sb-router__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="sb-router">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sb-router__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-2&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="799.6" y="1162" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sb-runsc" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;runsc shim&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[gVisor · containerd-shim-runsc-v1]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Starts the gVisor sandbox for the&lt;br&gt;pod in place of runc.&lt;br&gt;Why: installed once per node.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#172033;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1690" y="1170" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sb-runsc__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="sb-runsc">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sb-runsc__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-2&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="1939.6" y="1162" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sb-runtime" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;Runtime server&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[python-runtime-sandbox :8888]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Runs commands, reads, writes files&lt;br&gt;for the agent.&lt;br&gt;Why: the agent&amp;#39;s hands, isolated.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#0b2d31;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1020" y="1420" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sb-runtime__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="sb-runtime">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sb-runtime__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-2&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="1269.6" y="1412" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sb-sentry" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;gVisor Sentry&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[user-space kernel · Go]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Answers every syscall of the code&lt;br&gt;itself, in user space.&lt;br&gt;Why: host kernel stays out of reach.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#3f152f;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1420" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sb-sentry__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="sb-sentry">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sb-sentry__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-2&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="1619.6" y="1412" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sb-netstack" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;gVisor Netstack&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[user-space TCP/IP]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;The sandbox&amp;#39;s own network stack;&lt;br&gt;packets leave through the pod veth.&lt;br&gt;Why: no host TCP/IP for the code.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#3f152f;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1420" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sb-netstack__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="sb-netstack">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sb-netstack__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-2&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="1969.6" y="1412" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n-sb-warm" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;A claim takes a Sandbox that is already running in the pool; the pool then starts a new one from the template. Setting env or volumes on the claim forces a cold start instead.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="2160" y="1100" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n-sb-gvisor" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;gVisor: the code&amp;#39;s syscalls never reach the host kernel directly. The Sentry, a kernel written in Go, answers them in user space and only makes a small, seccomp-filtered set of host calls. The price: slower I/O and some syscalls missing.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="2160" y="1420" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n-sb-end" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;End of life: the agent deletes its claim, or lifecycle.shutdownTime / ttlSecondsAfterFinished does it. shutdownPolicy Delete removes Sandbox, Pod and Service; Retain keeps them for debugging.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="2660" y="1100" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="card-steps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#34d399&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Request path · an agent runs code it wrote&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; The agent creates a SandboxClaim with warmPoolRef python through the Kubernetes API (its Role allows claims only), then watches it until Ready.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; The extensions controller binds the claim to a warm Sandbox and writes its name and serviceFQDN in the claim&amp;#39;s status.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; The agent sends the command to sandbox-router with the Python SDK (k8s-agent-sandbox).&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;4&lt;/span&gt; The router forwards it to the runtime server of that sandbox on port 8888; the NetworkPolicy admits only the router.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;5&lt;/span&gt;–&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;7&lt;/span&gt; Every syscall of the code is trapped by the gVisor Sentry; network goes through Netstack; the host kernel only sees the Sentry&amp;#39;s filtered calls.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1960" width="1560" height="220" as="geometry" />
        </mxCell>
        <mxCell id="card-background" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#fbbf24&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Background · how a warm sandbox comes up&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;A&lt;/span&gt; The Sandbox controller sees each Sandbox the pool asked for and creates its Pod and headless Service.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;B&lt;/span&gt; The API server sends the Pod to Kyverno: gvisor RuntimeClass, PSS restricted and no service account token, or refused.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;C&lt;/span&gt; The kubelet of the chosen node sees the Pod. &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;D&lt;/span&gt; It asks containerd for a pod sandbox with handler runsc.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;E&lt;/span&gt; containerd starts the runsc shim. &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;F&lt;/span&gt; runsc boots the Sentry, which then starts the runtime server.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1640" y="1960" width="1580" height="220" as="geometry" />
        </mxCell>
        <mxCell id="card-objects" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#38bdf8&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Objects · who points at whom&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• SandboxClaim → SandboxWarmPool → SandboxTemplate → RuntimeClass gvisor and the NetworkPolicy it manages.&lt;br&gt;• SandboxClaim status → Sandbox → headless Service; the Sandbox owns the Pod.&lt;br&gt;• Memory: one warm python sandbox costs a pod&amp;#39;s RAM all the time; keep replicas at 1 on this cluster, raise it on a cloud cluster.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2220" width="1560" height="160" as="geometry" />
        </mxCell>
        <mxCell id="card-legend" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#94a3b8&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Legend&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1640" y="2220" width="1580" height="360" as="geometry" />
        </mxCell>
        <mxCell id="legend-node-backend" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#0b2d31;strokeColor=#34d399;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1660" y="2276" width="22" height="14" as="geometry" />
        </mxCell>
        <mxCell id="legend-node-backend-text" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;service / routing&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1692" y="2272" width="730" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend-node-security" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#3f152f;strokeColor=#fb7185;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1660" y="2302" width="22" height="14" as="geometry" />
