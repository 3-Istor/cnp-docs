        <mxCell id="card-read" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#059669&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Reading it&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• Everyone logs in once, with the same company account, in every tool.&lt;br&gt;• The CMP writes to GitHub; Argo CD reads GitHub and deploys to the cluster chosen for the project.&lt;br&gt;• An operator starts and stops the cloud clusters to control costs.&lt;br&gt;• The public cloud box stands for AWS and Google Cloud: same setup on both.&lt;br&gt;• The public clouds send metrics back to the on-prem hub; their logs follow with Cloud PR #50 (planned).&lt;br&gt;• An AI assistant works through the CMP MCP server, with the same rights as the user who approved it.&lt;br&gt;• Repo import opens a pull request on the user&amp;#39;s repo. The Placement view is for platform operators only.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="880" y="1120" width="800" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
