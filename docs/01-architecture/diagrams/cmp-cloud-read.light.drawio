        <mxCell id="cloud-api" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;&amp;lt;cloud&amp;gt; API&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[Kubernetes API]&lt;/font&gt;&lt;/i&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1119" y="200" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="cloud-api__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="cloud-api">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="seq-loki" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;Loki gateway&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[basic auth · tenant header]&lt;/font&gt;&lt;/i&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#fff1f2;html=1;whiteSpace=wrap;strokeColor=#e11d48;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1359" y="200" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="seq-loki__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="seq-loki">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;background, not on a request path: cache older than 60 s → one refresh task, callers never wait&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="309" y="302" width="602" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Healthy → up · Progressing → starting · else down · no Application → unknown&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="366" y="446" width="488" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;up → down if sync is Unknown or a condition ends in Error (Argo CD keeps a stale Healthy)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="327" y="494" width="566" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;kube_client(cloud=&amp;lt;cloud&amp;gt;): cached state is up&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="456" y="638" width="308" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-5" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;401 → the backend re-reads the Secret once&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1067" y="830" width="284" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-6" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;cached state is down, starting or unknown: nothing is sent to the cloud API&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="369" y="1022" width="482" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-7" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;« Cluster AWS non connecté » in the tab&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="237" y="1118" width="266" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-8" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;logs pushed earlier through WireGuard: readable while the cloud is down&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1245" y="1214" width="458" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-9" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;unknown → re-read up to 4 times, 5 s apart&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="468" y="1406" width="284" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-10" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;outcome: up → 202 · down or starting → 409 · still unknown → 503&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="402" y="1454" width="416" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
