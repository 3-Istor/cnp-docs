          <mxGeometry x="372" y="1822" width="198" height="22" as="geometry" />
        </mxCell>
        <mxCell id="card-legend-notes" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Large dashed frame: infra perimeter · small: functional group&lt;br&gt;&lt;font color=&quot;#fb923c&quot;&gt;&lt;b&gt;⚠ Gx&lt;/b&gt;&lt;/font&gt;: docs and code disagree, see &quot;Gaps&quot;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1890" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card-data-plane" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#22d3ee&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Request path · data plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; Browser sends GET https://&amp;lt;app&amp;gt;-&amp;lt;project&amp;gt;.3istor.com. Cloudflare terminates TLS.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; The edge relays it back through the app tunnel, opened outbound by cloudflared.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; cloudflared forwards to Envoy over HTTP; Envoy checks the OIDC session.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;4&lt;/span&gt; Envoy proxies to the Service. &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;5&lt;/span&gt; Cilium DNATs to a pod. &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;6&lt;/span&gt; The app queries its CNPG cluster.&lt;br&gt;• The CMP portal and Keycloak are reached the same way, through the platform tunnel.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="610" y="1640" width="700" height="300" as="geometry" />
        </mxCell>
        <mxCell id="card-control-plane" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#a78bfa&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Background · control plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;New project.&lt;/font&gt;&lt;/b&gt; The CMP backend writes registry/projects/&amp;lt;name&amp;gt;.yaml in cnp-projects &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;A&lt;/span&gt;, then a Terraform bootstrap creates the Keycloak groups, the Vault policy and the Argo CD AppProject.&lt;br&gt;• &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Deployment.&lt;/font&gt;&lt;/b&gt; Argo CD polls the registry and the charts &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;B&lt;/span&gt; and applies each project&amp;#39;s apps through the API server &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;C&lt;/span&gt;.&lt;br&gt;• &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Secrets.&lt;/font&gt;&lt;/b&gt; VSO reads Vault &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;D&lt;/span&gt; and writes the app Secret &lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;E&lt;/span&gt;.&lt;br&gt;• Kyverno checks resource limits in Audit mode. offhours-guard scales apps to zero off hours.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1640" width="820" height="300" as="geometry" />
        </mxCell>
        <mxCell id="card-gaps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#fb923c&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Gaps between docs and code&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G7&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;CMP API auth.&lt;/font&gt;&lt;/b&gt; The /api route has no OIDC policy and the backend decodes JWTs without checking signature or expiry: a forged token is accepted.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G1&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Network isolation.&lt;/font&gt;&lt;/b&gt; Docs describe a default-deny CCNP per project. None in code.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G2&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Authorization.&lt;/font&gt;&lt;/b&gt; No groups-claim check: any account in realm 3istor opens any SSO app.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G8&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Pod sandbox.&lt;/font&gt;&lt;/b&gt; securityContext and probes are declared, never rendered: pods run as root.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G3&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Transport.&lt;/font&gt;&lt;/b&gt; TLS ends at Cloudflare; in-cluster hops are plain HTTP, Vault included.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G4&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Coupling.&lt;/font&gt;&lt;/b&gt; Tunnels target Envoy&amp;#39;s Service by name. &lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G5&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Tunnels.&lt;/font&gt;&lt;/b&gt; One per app on :latest; D-06 moves to one per project.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G6&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Token call.&lt;/font&gt;&lt;/b&gt; No cluster-local path to auth.3istor.com found: likely hairpins via Cloudflare.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G9&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;ReferenceGrant.&lt;/font&gt;&lt;/b&gt; Envoy reaches Keycloak only from 8 hand-listed namespaces.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fb923c&quot;&gt;G10&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#f8fafc&quot;&gt;Gateway label.&lt;/font&gt;&lt;/b&gt; New app namespaces never get prod-gateway-access, needed by the shared gateway.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="2190" y="1640" width="1550" height="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
