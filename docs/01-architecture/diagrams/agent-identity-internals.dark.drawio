        <mxCell id="legend-node-tool-text" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;tool, no runtime traffic&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#e2e8f0;" vertex="1" parent="1">
