        <mxCell id="legend-stack-7-1" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
