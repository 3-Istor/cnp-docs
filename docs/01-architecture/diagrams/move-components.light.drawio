        </mxCell>
        <mxCell id="card-legend-notes" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Large dashed frame: infra perimeter · small: functional group&lt;br&gt;&lt;font color=&quot;#c2410c&quot;&gt;&lt;b&gt;⚠ Gx&lt;/b&gt;&lt;/font&gt;: docs and code disagree, see &quot;Gaps&quot;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="1240" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card-read" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#059669&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;In short&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• The CMP drives the move and commits the decision to the registry; Argo CD reads it and deploys.&lt;br&gt;• The CMP also acts on the clusters directly: check the Vault role, copy VaultSecrets, stop apps, final backup, commit the restore to the app repo, delete the source.&lt;br&gt;• The database goes through one S3 bucket on the on-prem Ceph: backup on the source, restore on the target.&lt;br&gt;• A cloud reaches the bucket through WireGuard, an on-prem cluster directly. One end is a cloud, or both.&lt;br&gt;• One tunnel, one connector per cluster: the target connector stays at 0 replicas until the switch.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="640" y="1000" width="1040" height="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
