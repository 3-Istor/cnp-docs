        <mxCell id="legend-stack-14-text" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;one per imported service&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#1e293b;" vertex="1" parent="1">
