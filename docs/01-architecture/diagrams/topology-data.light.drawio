        <mxCell id="card-legend-notes" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Large dashed frame: infra perimeter · small: functional group&lt;br&gt;&lt;font color=&quot;#c2410c&quot;&gt;&lt;b&gt;⚠ Gx&lt;/b&gt;&lt;/font&gt;: docs and code disagree, see &quot;Gaps&quot;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="1850" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card-steps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#059669&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Request path · reading the Topology&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; The tab asks the CMP for the project&amp;#39;s topology; the user needs member or above.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Nodes and declared edges.&lt;/font&gt;&lt;/b&gt; The registry record lists the apps and their dependsOn links.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Node state.&lt;/font&gt;&lt;/b&gt; Application health and sync from Argo CD, offhours state from the OffhoursSchedule, both read through the API.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;4&lt;/span&gt; &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Observed edges.&lt;/font&gt;&lt;/b&gt; Flow counters by source and destination workload and verdict, over the last minutes, from VMSingle.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="600" y="1360" width="720" height="260" as="geometry" />
        </mxCell>
        <mxCell id="card-bg" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#7c3aed&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Background&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;A&lt;/span&gt; Argo CD polls the registry and &lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;B&lt;/span&gt; applies, then writes Application health.&lt;br&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;C&lt;/span&gt; vmagent scrapes the Hubble flow metrics on each cilium-agent (:9965) and &lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;D&lt;/span&gt; remote-writes them to VMSingle.&lt;br&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;E&lt;/span&gt; Dropped flows also leave Cilium as logs: Fluent Bit sends them to VictoriaLogs, where POLICY_DENIED lines can be searched.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="600" y="1650" width="720" height="250" as="geometry" />
        </mxCell>
        <mxCell id="card-edges" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#4f46e5&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Edge states on the canvas&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Declared and observed:&lt;/font&gt;&lt;/b&gt; solid. &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Declared only:&lt;/font&gt;&lt;/b&gt; dashed grey.&lt;br&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Observed only:&lt;/font&gt;&lt;/b&gt; amber, with a &amp;#39;declare this link&amp;#39; action.&lt;br&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Denied:&lt;/font&gt;&lt;/b&gt; red, from flows with verdict DROPPED.&lt;br&gt;• Hubble Relay (later) feeds a drawer of live flows for one edge; the canvas never depends on it.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1360" width="700" height="260" as="geometry" />
        </mxCell>
        <mxCell id="card-gaps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#ea580c&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Gaps between docs and code&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Live flows.&lt;/font&gt;&lt;/b&gt; Hubble metrics are scraped by vmagent; the drawer of live flows through Hubble Relay is still to build.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1650" width="1440" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
