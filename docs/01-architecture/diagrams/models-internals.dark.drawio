          <mxGeometry x="3279.6" y="1010" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="md-ollama-cfg" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;Ollama settings&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[server environment]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;MAX_LOADED_MODELS 3, NUM_PARALLEL 2,&lt;br&gt;KEEP_ALIVE -1, CONTEXT_LENGTH 8192,&lt;br&gt;KV cache q8_0.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#172033;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="3380" y="1146" width="340" height="104" as="geometry" />
        </mxCell>
        <mxCell id="md-ollama-cfg__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="md-ollama-cfg">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="md-ollama-cfg__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="3669.6" y="1138" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="gemini__port_left_2600_415" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 443&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#fbbf24;strokeColor=#020617;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;movable=0;resizable=0;" vertex="1" parent="gemini">
          <mxGeometry x="-22.90000000000009" y="77" width="45.8" height="16" as="geometry" />
        </mxCell>
        <mxCell id="gpu-server__port_left_2600_985" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 443&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#94a3b8;strokeColor=#020617;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;movable=0;resizable=0;" vertex="1" parent="gpu-server">
          <mxGeometry x="-22.90000000000009" y="87" width="45.8" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n-md-terms" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Check before going live: Google&amp;#39;s Gemini API terms allow only the paid service when an API client is made available to users in the EEA, the UK or Switzerland. Free-tier inputs may also be read by human reviewers and used to improve Google&amp;#39;s products: no sensitive data. Rotating free accounts is not covered by the terms read so far.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="3760" y="260" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n-md-local" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Local projects: the data_level claim is copied into x-cnp-data; the llm-local route matches it and its backend only knows the GPU server, so Gemini is never a candidate, even after a failure.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="3760" y="530" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n-md-contract" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;The GPU server is only a contract: text and embeddings in IA-1, the guard and the image tool in IA-2. Each service sits behind Caddy: HTTPS, one token per consumer (the gateway, the guard webhook, the image MCP server), cluster node IPs only, no web UI for tenants. The text model is a setting (D37); the guard and the embeddings stay loaded.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="3760" y="740" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="card-steps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#34d399&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Request path · a model call leaves the gateway&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; The provider choice picks the backend: llm for normal projects (group 1 Gemini keys, group 2 the GPU server), llm-local for Local projects (the GPU server only).&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; The LLM proxy calls Gemini with one of the keys, over HTTPS; the Cilium egress rule allows that host and the GPU server&amp;#39;s /32 only.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; Google counts the request against the Google Cloud project&amp;#39;s RPM, TPM and RPD. If any one is spent, the answer is 429; the key is evicted for a while.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;4&lt;/span&gt; After a 429, or for Local projects, the LLM proxy calls the GPU server over HTTPS with its token. &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;5&lt;/span&gt; Caddy sends chat calls to the text service. &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;6&lt;/span&gt; The text service runs the model on the GPU.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1500" width="2060" height="230" as="geometry" />
        </mxCell>
        <mxCell id="card-background" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#fbbf24&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Background&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;A&lt;/span&gt; The text service loads a model&amp;#39;s weights from its store on first use and keeps them (KEEP_ALIVE -1). The image tool is the one exception: its GPU lock unloads the text model while ComfyUI generates, then the text model reloads on the next request; the guard and the embeddings stay loaded.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="2140" y="1500" width="2040" height="230" as="geometry" />
        </mxCell>
        <mxCell id="card-objects" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#38bdf8&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Objects · who points at whom&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• HTTPRoute llm → AgentgatewayBackend llm (group 1: Gemini providers, one Secret each; group 2: the GPU server, token Secret); HTTPRoute llm-local → llm-local (the GPU server only).&lt;br&gt;• AgentgatewayPolicy failover → backend llm: evicts a provider on 429 so that the next group takes over.&lt;br&gt;• Only keys from different Google Cloud projects add quota: the limits are per project, not per key.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1770" width="2060" height="200" as="geometry" />
        </mxCell>
        <mxCell id="card-legend" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#94a3b8&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Legend&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="2140" y="1770" width="2040" height="360" as="geometry" />
        </mxCell>
