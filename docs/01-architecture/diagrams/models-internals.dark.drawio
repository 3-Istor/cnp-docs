        <mxCell id="md-spend" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;Console spend limit&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[Anthropic console · per month]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Past the limit the API refuses calls.&lt;br&gt;Why: a bug cannot spend more than&lt;br&gt;the credit put on the key.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#3f152f;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="2990" y="332" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="md-spend__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="md-spend">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="md-spend__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="3239.6" y="324" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="md-egress" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;CiliumNetworkPolicy ai-egress&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[toFQDNs · port 443]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;The proxy may reach api.anthropic.com&lt;br&gt;on 443 only.&lt;br&gt;Why: a bug can&amp;#39;t send data away.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#3f152f;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="2040" y="400" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="md-egress__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="md-egress">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="md-egress__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="2289.6" y="392" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="anthropic__port_left_2600_415" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 443&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#fbbf24;strokeColor=#020617;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;movable=0;resizable=0;" vertex="1" parent="anthropic">
          <mxGeometry x="-22.90000000000009" y="77" width="45.8" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n-md-terms" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Prompts and answers leave for Anthropic. promptGuard masks PII and secrets with its built-in regexes before the call; a critical project cannot enable AI at all. There is no Local data level any more.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="3440" y="260" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n-md-local" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;No fallback: if the API is down or the spend limit is reached, the call fails with a clear error, never a degraded mode (principle 6).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="3440" y="530" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n-md-contract" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;The model is a setting: claude-haiku-5-5 by default (effort low), claude-sonnet-5-5 (effort medium) for an agent that needs more reasoning. Per MTok: Sonnet 5.5 $2 in, $10 out, $0.10 cache read; Haiku 5.5 $0.10 in, $0.50 out.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="3440" y="740" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="card-steps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#34d399&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Request path · a model call leaves the gateway&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; The provider choice sends the call to the one backend, llm, with a model the project allows.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; The LLM proxy calls the Anthropic Messages API with the key from the Secret, over HTTPS; the Cilium egress rule allows api.anthropic.com:443 only.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; Anthropic counts the spend against the console limit: the hard money fuse, on top of the gateway&amp;#39;s daily token budget per agent.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1880" height="230" as="geometry" />
        </mxCell>
        <mxCell id="card-background" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#fbbf24&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Background&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• VSO writes the Secret anthropic-api-key from Vault kvv2/platform/ai/anthropic, in the ai-gateway namespace only. Kyverno ai-no-provider-keys refuses a provider key in any other namespace.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
