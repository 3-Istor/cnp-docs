        <mxCell id="toolhive__port_left_1310_925" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 8080&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#059669;strokeColor=#f8fafc;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#ffffff;movable=0;resizable=0;" vertex="1" parent="toolhive">
          <mxGeometry x="-25.59999999999991" y="57" width="51.199999999999996" height="16" as="geometry" />
        </mxCell>
        <mxCell id="tempo__port_top_250_1030" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 4317&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#7c3aed;strokeColor=#f8fafc;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#ffffff;movable=0;resizable=0;" vertex="1" parent="tempo">
          <mxGeometry x="114.4" y="-8" width="51.199999999999996" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n-authz" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;The SecurityPolicy checks the JWT and the project claim before routing: no match, 403. AIGatewayRoute then picks the model the project may use.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="1760" y="840" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n-fallback" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Gemini answers 429 when the free quota is spent: the gateway retries on Ollama. Projects marked Local never reach Gemini.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="1760" y="980" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="card-steps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#059669&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Request path · a hosted agent asks a model&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• Before &lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt;, the agent gets a short token from Keycloak by token exchange: see the ai-gateway-call sequence.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; The agent calls POST /v1/chat/completions on the internal listener with that token; the SecurityPolicy validates it and checks the project claim.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; The gateway checks the project&amp;#39;s token quota in the rate limit service.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; It calls Gemini with the key from the Secret, through the FQDN egress allow-list; on 429 or for Local projects it calls Ollama instead.&lt;br&gt;• Tool calls take the same chain, then MCPRoute sends them to the CMP&amp;#39;s MCP server (stake policy) or to a ToolHive server.&lt;br&gt;• Tenant apps call the gateway like the agent, with their project&amp;#39;s token.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="1250" width="1020" height="230" as="geometry" />
        </mxCell>
        <mxCell id="card-background" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#d97706&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Background · control plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;A&lt;/span&gt; The proxy fetches Keycloak&amp;#39;s JWKS and caches it.&lt;br&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;B&lt;/span&gt; The secrets operator reads the Gemini key from Vault.&lt;br&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;C&lt;/span&gt; It writes the Secret that the AIGatewayRoute&amp;#39;s backend security policy references.&lt;br&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;D&lt;/span&gt; The proxy pushes GenAI spans and token metrics to Alloy over OTLP.&lt;br&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;E&lt;/span&gt; Alloy writes the traces to Tempo; Grafana shows tokens, cost and latency per project.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1250" width="1020" height="230" as="geometry" />
        </mxCell>
        <mxCell id="card-plan" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#0284c7&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;What this proposal adds · targets&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;IA-1&lt;/font&gt;&lt;/b&gt; AI gateway (proxy, routes, SecurityPolicy, rate limit), Gemini and Ollama backends, Tempo.&lt;br&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;IA-2&lt;/font&gt;&lt;/b&gt; Hosted agents in sandboxed namespaces (Sandbox CRD, gVisor), ToolHive MCP servers.&lt;br&gt;• Prerequisites from the current platform: G1 default-deny between tenants, G8 pod security context, G17 protected GitOps branches.&lt;br&gt;• Memory budget on this cluster: about 1 to 2.5 GB in total; to measure once deployed.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="1510" width="1020" height="200" as="geometry" />
        </mxCell>
        <mxCell id="card-legend" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#64748b&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Legend&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
