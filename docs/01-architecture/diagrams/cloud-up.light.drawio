        <mxCell id="note-4" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;kept across down: cluster entry, auth mount, roles incl. observability-role, VPN keys&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="924" y="782" width="542" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-5" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;done by hand; the rest is automatic&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="29" y="974" width="242" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-6" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;refresh Argo CD Secret cluster-&amp;lt;cloud&amp;gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1620" y="1070" width="260" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-7" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;one sync installs Envoy, CNPG, VSO, guardrails, Alloy, exporters, Rollouts, Kyverno, Trivy, offhours-guard&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1676" y="1166" width="668" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-8" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;CNP-112: cloud Applications retry forever, backoff 30 s to 3 min, refresh to the last commit&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1718" y="1214" width="584" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-9" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;secrets synced, incl. loki-clients (observability-role) for Alloy&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="2039" y="1406" width="422" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-10" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;no handshake for 180 s&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="3006" y="1550" width="164" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-11" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;tunnel up&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="2787" y="1742" width="86" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-12" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;fails until the handshake; label cluster=&amp;lt;cloud&amp;gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="2380" y="1790" width="320" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-13" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;absent → unknown · Progressing → starting · Healthy, sync ≠ Unknown, no *Error condition → up, else down; list views use a 60 s cache, the deploy guard reads fresh (unknown retried 4 × 5 s)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="3270" y="2078" width="1166" height="28" as="geometry" />
