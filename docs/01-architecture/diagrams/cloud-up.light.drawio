        </mxCell>
        <mxCell id="note-3" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;EKS: vpc-cni prefix delegation, 110 pods per new node · GKE: logging and monitoring none&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
