        <mxCell id="note-2" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;the cloud APIs see 176.186.130.237 · api_allowed_cidrs = the K3s egress 176.186.130.237/32&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
