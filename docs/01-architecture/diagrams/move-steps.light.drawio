        <mxCell id="mv-s-prepare" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;1 · prepare&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[source still serving]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Bootstrap targets the&lt;br&gt;target: system ns,&lt;br&gt;gateway, tunnel at 0,&lt;br&gt;app namespaces&lt;br&gt;CMP copies VaultSecrets&lt;br&gt;Image pre-pull on nodes&lt;br&gt;to on-prem 3m44&lt;br&gt;to AWS 2m17&lt;br&gt;(before: 35 to 51 s)&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="176" height="200" as="geometry" />
        </mxCell>
        <mxCell id="mv-s-stop" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;2 · stop_source&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[cut starts]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Apps to 0 replicas&lt;br&gt;Wait for pods gone&lt;br&gt;to on-prem 16 s&lt;br&gt;to AWS 24 s&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="336" y="270" width="176" height="200" as="geometry" />
        </mxCell>
        <mxCell id="mv-s-backup" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;3 · final_backup&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;CNPG backup on the&lt;br&gt;source, into the&lt;br&gt;bucket&lt;br&gt;to on-prem 15 s&lt;br&gt;to AWS 30 s&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f5f3ff;html=1;whiteSpace=wrap;strokeColor=#7c3aed;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="536" y="270" width="176" height="200" as="geometry" />
        </mxCell>
        <mxCell id="mv-s-switch" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;4 · switch&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Registry commit:&lt;br&gt;targetCloud = target&lt;br&gt;Target tunnel 0 to 1&lt;br&gt;(applied in wait_target)&lt;br&gt;commit takes 3 s&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#fffbeb;html=1;whiteSpace=wrap;strokeColor=#d97706;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="736" y="270" width="176" height="200" as="geometry" />
        </mxCell>
        <mxCell id="mv-s-wait" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;5 · wait_target&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Argo sync, first pod,&lt;br&gt;DB restore, migration,&lt;br&gt;CMP sees apps healthy&lt;br&gt;to on-prem 4m35&lt;br&gt;to AWS 2m47&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="936" y="270" width="176" height="200" as="geometry" />
        </mxCell>
        <mxCell id="mv-s-persist" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;6 · persist_restores&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Commit db.restore&lt;br&gt;generation to the&lt;br&gt;app repo, wait for&lt;br&gt;Argo to render it&lt;br&gt;about 50 s&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1136" y="270" width="176" height="200" as="geometry" />
        </mxCell>
        <mxCell id="mv-s-cleanup" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;7 · cleanup_source&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[cut ends]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;Source namespaces&lt;br&gt;deleted, &amp;lt;p&amp;gt;-backups&lt;br&gt;kept&lt;br&gt;Source tunnel goes&lt;br&gt;away here&lt;br&gt;1m47&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1412" y="270" width="176" height="200" as="geometry" />
        </mxCell>
        <mxCell id="mv-s-finish" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;8 · finish&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;status.move cleared,&lt;br&gt;audit event,&lt;br&gt;notification&lt;br&gt;9 s&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#ecfdf5;html=1;whiteSpace=wrap;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1612" y="270" width="176" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n-cut-start" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#c2410c&quot;&gt;CUT STARTS&lt;/font&gt;&lt;/b&gt;: the apps stop serving.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="336" y="530" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n-cut-end" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#c2410c&quot;&gt;CUT ENDS&lt;/font&gt;&lt;/b&gt;: at cleanup_source. Until then Cloudflare still sends part of the requests to the stopped source.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="1412" y="530" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="card-cut" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#059669&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;The cut, before and after the optimisation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;User-visible cut&lt;/font&gt;&lt;/b&gt; (stop_source to cleanup_source start)&lt;br&gt;• To on-prem: 6m31 / 7m36 before, &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;5m59&lt;/font&gt;&lt;/b&gt; after&lt;br&gt;• To AWS: 4m50 before, &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;4m35&lt;/font&gt;&lt;/b&gt; after&lt;br&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Engine cut&lt;/font&gt;&lt;/b&gt; (stop_source to target healthy)&lt;br&gt;• To on-prem: 5m57 / 6m46 before, &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;5m09&lt;/font&gt;&lt;/b&gt; after&lt;br&gt;• To AWS: about 4m00 before, &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;3m44&lt;/font&gt;&lt;/b&gt; after&lt;br&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Switch commit to first pod on the target&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• To on-prem: about 2m30 before, &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;63 s&lt;/font&gt;&lt;/b&gt; after&lt;br&gt;• To AWS: 1m38 before, &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;55 s&lt;/font&gt;&lt;/b&gt; after&lt;br&gt;• Target setup and image pulls moved into prepare, before the cut: 35 to 51 s before, now 3m44 to on-prem, 2m17 to AWS, not felt by users.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="640" height="270" as="geometry" />
        </mxCell>
        <mxCell id="card-wait" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#0284c7&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Inside wait_target, move 10 (to on-prem, 4m35)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• Observed on Argo CD events and pods, not engine sub-steps.&lt;br&gt;• Argo CD sync starts: 25 s after the switch commit&lt;br&gt;• First pod: +38 s&lt;br&gt;• DB restore starts: +25 s&lt;br&gt;• DB restore and DB ready: 85 s&lt;br&gt;• Migration: 66 s&lt;br&gt;• Backend ready, CMP detects healthy: 37 s&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="720" y="640" width="540" height="270" as="geometry" />
        </mxCell>
        <mxCell id="card-rpo" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#7c3aed&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;RPO 0 in every move&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• A test check, not an engine step: measured on the test app.&lt;br&gt;• md5 of the todo table on the source at stop equals the md5 on the target after the restore.&lt;br&gt;• Equal in all five moves (6 to 10).&lt;br&gt;• The final backup is taken once the apps are at 0, so nothing writes after it.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1300" y="640" width="508" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
