  <diagram id="access-matrix-light" name="CNP · Access matrix · what the segregation plan and the portal roles change (light)">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3934" pageHeight="1608" background="#f8fafc" math="0" shadow="0">
