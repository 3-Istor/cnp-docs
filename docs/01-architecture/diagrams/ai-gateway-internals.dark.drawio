        <mxCell id="ag-x-otel" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;Telemetry&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[OTel GenAI · spans, metrics]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Spans over OTLP; token and cost&lt;br&gt;metrics on :15020 for scraping.&lt;br&gt;Why: cost and speed per agent.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#172033;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1850" y="1860" width="340" height="104" as="geometry" />
        </mxCell>
        <mxCell id="ag-x-otel__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ag-x-otel">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ag-x-otel__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="2139.6" y="1852" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ag-rl" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;Rate limit service&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[envoyproxy/ratelimit · gRPC]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Counts tokens per agent and per day against&lt;br&gt;the limits of the ConfigMap ratelimit-config.&lt;br&gt;Why: one shared budget.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#0b2d31;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="2850" y="1436" width="340" height="104" as="geometry" />
        </mxCell>
        <mxCell id="ag-rl__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ag-rl">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ag-rl__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="3139.6" y="1428" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ag-redis" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;Redis&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[counters with TTL]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Stores the counters per window.&lt;br&gt;Why: shared by the service replicas.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#271955;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="3250" y="1436" width="340" height="104" as="geometry" />
        </mxCell>
        <mxCell id="ag-redis__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ag-redis">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ag-redis__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-1&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="3539.6" y="1428" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ag-hook" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;Guardrail adapter&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[in-house · POST /request]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Turns the gateway&amp;#39;s webhook call into&lt;br&gt;a Llama Guard check on the GPU server.&lt;br&gt;Why: the two formats do not match.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#3f152f;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="830" y="2316" width="340" height="104" as="geometry" />
        </mxCell>
        <mxCell id="ag-hook__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="ag-hook">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ag-hook__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-2&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="1119.6" y="2308" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="md-guard" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:12px&quot;&gt;Guard · llama-guard3:1b&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#e2e8f0&quot; style=&quot;font-size:10px&quot;&gt;[Ollama · classifier]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px&quot;&gt;Always loaded; classifies prompts and&lt;br&gt;answers for the guardrail adapter.&lt;br&gt;Down: the request is refused.&lt;/font&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#3f152f;html=1;whiteSpace=wrap;strokeColor=#34d399;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="3790" y="2062" width="340" height="104" as="geometry" />
        </mxCell>
        <mxCell id="md-guard__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="md-guard">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="md-guard__pill" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;+ IA-2&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#34d399;strokeColor=none;align=center;verticalAlign=middle;fontStyle=1;movable=0;connectable=0;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;" vertex="1" parent="1">
          <mxGeometry x="4079.6" y="2054" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="keycloak__port_bottom_430_1410" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 80&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#fb7185;strokeColor=#020617;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;movable=0;resizable=0;" vertex="1" parent="keycloak">
          <mxGeometry x="299.8" y="96" width="40.4" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ag-rl__port_left_2850_1488" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 8081&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#34d399;strokeColor=#020617;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;movable=0;resizable=0;" vertex="1" parent="ag-rl">
          <mxGeometry x="-25.59999999999991" y="44" width="51.199999999999996" height="16" as="geometry" />
        </mxCell>
        <mxCell id="gpu-server__port_left_3790_2000" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 443&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#94a3b8;strokeColor=#020617;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;movable=0;resizable=0;" vertex="1" parent="gpu-server">
          <mxGeometry x="-22.90000000000009" y="72" width="45.8" height="16" as="geometry" />
        </mxCell>
        <mxCell id="gemini__port_left_3790_1635" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 443&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#fbbf24;strokeColor=#020617;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;movable=0;resizable=0;" vertex="1" parent="gemini">
          <mxGeometry x="-22.90000000000009" y="77" width="45.8" height="16" as="geometry" />
        </mxCell>
        <mxCell id="gpu-server__port_left_3790_1972" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 443&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#94a3b8;strokeColor=#020617;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;movable=0;resizable=0;" vertex="1" parent="gpu-server">
          <mxGeometry x="-22.90000000000009" y="44" width="45.8" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ag-x-otel__port_left_1850_1912" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;TCP 15020&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#94a3b8;strokeColor=#020617;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=9;fontColor=#020617;movable=0;resizable=0;" vertex="1" parent="ag-x-otel">
          <mxGeometry x="-28.299999999999955" y="44" width="56.6" height="16" as="geometry" />
        </mxCell>
        <mxCell id="n-ag-order" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;The docs run the traffic policies in a fixed order: JWT, authorization, rate limit, then the route and the backend policies, promptGuard among them. A prompt the guard refuses has therefore already passed the budget check.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="3760" y="260" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n-ag-failover" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;On a 429 the health policy evicts the Gemini key that answered it; the load balancer then picks another key of group 1, and when all are evicted, group 2: the GPU server. Keys of one Google project share one quota, so only keys from different projects add capacity.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="3760" y="470" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n-ag-budget" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;The budget is per agent and per day, keyed by a JWT claim (azp, to confirm in the phase 1 trial); cost per project is computed in Grafana. The check runs before the call; the real token count is known after the answer, and how the rate limit service receives it is for the trial to confirm. The 4,096 max_tokens cap, the 30 requests a minute and the refusal when the service is down (D32) are also verified in the trial (T1.1).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="3760" y="700" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="card-steps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#34d399&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Request path · an agent asks a model&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; The agent sends POST /v1/chat/completions with its Keycloak JWT to the listener of the Gateway ai-gateway.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; jwtAuthentication checks the signature against the cached JWKS, iss and aud; authorization applies the CEL rules on the claims, deny by default.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;4&lt;/span&gt;–&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;6&lt;/span&gt; rateLimit asks the rate limit service whether the agent&amp;#39;s daily token budget is spent; the service counts in Redis. Over the budget: 429. rateLimit also applies the local limiter, 30 requests a minute per agent, and the max_tokens cap of 4,096 comes from the limits policy. If the rate limit service is down, the request is refused (fail-closed).&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;7&lt;/span&gt; &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;8&lt;/span&gt; The route match picks the HTTPRoute and its AgentgatewayBackend; promptGuard masks PII and secrets, then asks the guardrail adapter (IA-2).&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;9&lt;/span&gt; &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;10&lt;/span&gt; The provider choice takes a healthy Gemini key of group 1; the LLM proxy speaks the provider&amp;#39;s API with the key from the Secret.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;11&lt;/span&gt; &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;12&lt;/span&gt; The call goes to Gemini over HTTPS through the Cilium FQDN egress rule. After a 429 the health policy evicts the key and the GPU server answers.&lt;br&gt;&lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;13&lt;/span&gt; &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;14&lt;/span&gt; The LLM proxy hands the token usage to the telemetry module, which sends the spans to Alloy over OTLP.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="40" y="3090" width="2160" height="300" as="geometry" />
        </mxCell>
        <mxCell id="card-background" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#fbbf24&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Background · control plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;A&lt;/span&gt; The translator watches Gateway API and agentgateway objects, with the AgentgatewayPolicy among them.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;B&lt;/span&gt; The status writer reports accepted or rejected on the Gateway, its listeners and routes.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;C&lt;/span&gt; The Deployer creates the proxy Deployment for each Gateway of the agentgateway class.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;D&lt;/span&gt; The proxy keeps an ADS stream open to the xDS server and receives its configuration as deltas.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;E&lt;/span&gt; The proxy fetches Keycloak&amp;#39;s JWKS and caches it.&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;F&lt;/span&gt; Before &lt;span style=&quot;background-color:#f8fafc;color:#020617;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt;, the agent gets a 5-minute JWT from Keycloak with its own client (client_credentials, or token exchange for a user).&lt;br&gt;&lt;span style=&quot;border:1px solid #f8fafc;color:#f8fafc;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;G&lt;/span&gt; Alloy scrapes the metrics endpoint (:15020) for token and cost series.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="2240" y="3090" width="1940" height="300" as="geometry" />
        </mxCell>
        <mxCell id="card-objects" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#38bdf8&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Objects · who points at whom&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• Gateway ai-gateway → GatewayClass agentgateway. HTTPRoutes llm, llm-local, mcp and a2a → the Gateway (parentRef) and their AgentgatewayBackend (backendRef).&lt;br&gt;• AgentgatewayBackend llm: group 1 = Gemini providers, one Secret each; group 2 = the GPU server (openai provider with host and port, token Secret). llm-local: the GPU server only.&lt;br&gt;• Budget: the global rateLimit of the policy (unit Tokens) points at the rate limit service, whose ConfigMap sets the limit per day; the local limiter has no day unit, so it only holds the 30 requests a minute per agent.&lt;br&gt;• AgentgatewayPolicy: auth, limits and trace → Gateway; budget → HTTPRoute llm; guard and failover → backend llm; tools → backend mcp (targetRefs).&lt;br&gt;• Where the rules come from (D36): the gateway&amp;#39;s rules (budget limits, tool allow-lists, CEL on the claims) are generated from the project&amp;#39;s ProjectRecord in cnp-projects, written by the CMP; an app&amp;#39;s own settings (blocks ai and agent of its deploy/values-*.yaml) never exceed it.&lt;br&gt;• Not drawn: extProc and extAuth hooks of the same policy kind. OPA would use extAuth (IA-3).&lt;br&gt;• Memory on the cluster: controller, proxy, rate limit service, Redis and the adapter should fit in a few hundred MB; to measure once deployed.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="40" y="3430" width="2160" height="260" as="geometry" />
        </mxCell>
